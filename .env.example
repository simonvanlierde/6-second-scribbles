# Cloudflare Tunnel token for deploying the application.
TUNNEL_TOKEN=your-tunnel-token-here

# On the deploy host only. With these, a plain `docker compose up -d` (Dockge's too)
# runs the prod config and includes cloudflared, which sits in the `tunnel` profile.
# Leave them out on a dev machine: the justfile names its compose files itself.
# COMPOSE_FILE=compose.yml:compose.prod.yml
# COMPOSE_PROFILES=tunnel
