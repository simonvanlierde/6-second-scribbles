{
  "name": "six-second-scribbles-multiplayer",
  "version": "0.3.0",
  "description": "Multiplayer web implementation of Six Second Scribbles party drawing game",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui --headed",
    "test:e2e:a11y": "playwright test -c playwright.a11y.config.ts",
    "format": "biome check --write .",
    "type-check": "svelte-check --tsconfig ./tsconfig.app.json && tsc --project tsconfig.node.json",
    "lint": "biome check ."
  },
  "dependencies": {
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@lingui/core": "^6.11.0",
    "lingui-for-svelte": "^0.7.1",
    "perfect-freehand": "1.2.3",
    "svelte": "^5.57.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@lingui/cli": "^6.11.0",
    "@lingui/conf": "^6.11.0",
    "@lingui/format-json": "^6.11.0",
    "@lingui/vite-plugin": "^6.11.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/node26": "^26.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "json-schema-to-zod": "^2.8.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
