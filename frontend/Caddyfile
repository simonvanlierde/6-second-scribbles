{
	servers {
		# In prod the only ingress is the Cloudflare tunnel: cloudflared runs as a
		# sibling container and reaches this Caddy over the Docker network, so the
		# peer address is always a private Docker IP. Trusting that range is what
		# lets CF-Connecting-IP (set by cloudflared) be believed and land in the
		# access log's `request.client_ip` instead of the cloudflared container IP.
		# `request.remote_ip` still records the real peer, so a spoofed header is
		# always visible as a mismatch between the two fields.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip
	}
}

:80 {
	# JSON to stderr so the Docker log driver picks it up; no volume to manage.
	# Visitor IPs are masked to their /24 (IPv4) or /48 (IPv6) network: enough to
	# spot abuse from one network, not enough to name a household.
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
				request>headers>Cf-Connecting-Ip ip_mask 24 48
				request>headers>X-Forwarded-For ip_mask 24 48
			}
		}
	}

	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# The SPA calls /api and /ws on its own origin (src/config/gameConfig.ts).
		# Under CSP Level 3, 'self' also allows ws:/wss: to the same host, which
		# all current browsers support. Drawings are shown as data: PNGs.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# The backend rate-limits by the last X-Forwarded-For entry. Caddy would
	# append its direct peer there, which is always the cloudflared container,
	# so every visitor would share one bucket. Send the visitor IP instead.
	handle /api/* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /ws/* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# RFC 9116. Renew the Expires date before it passes.
	handle /.well-known/security.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond `Contact: mailto:code@duinlab.nl
Contact: https://github.com/simonvanlierde/6-second-scribbles/security/advisories/new
Expires: 2027-11-09T00:00:00.000Z
Preferred-Languages: en, nl
Canonical: https://6ss.duinlab.nl/.well-known/security.txt
` 200
	}

	handle /healthz {
		# The container healthcheck hits this every 30s — don't drown the log in it.
		log_skip
		respond "ok" 200
	}

	handle {
		root * /usr/share/caddy

		# Content-hashed build assets are immutable → cache forever.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# App shell must revalidate so new deploys are picked up immediately.
		@html path / /index.html
		header @html Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
