{
  "include": ["src/**/*", "src/**/*.svelte", "vitest.setup.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["svelte", "vite/client", "vitest", "node", "jsdom"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["src/**/__tests__/**"]
}
