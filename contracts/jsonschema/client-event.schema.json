{
  "discriminator": {
    "mapping": {
      "cast_kick_vote": "#/$defs/CastKickVoteEvent",
      "default_locale_update": "#/$defs/DefaultLocaleUpdateEvent",
      "draw_stroke": "#/$defs/DrawStrokeEvent",
      "draw_stroke_partial": "#/$defs/DrawStrokePartialEvent",
      "drawpad_clear": "#/$defs/DrawpadClearEvent",
      "heartbeat": "#/$defs/HeartbeatEvent",
      "initiate_kick": "#/$defs/InitiateKickEvent",
      "join": "#/$defs/JoinEvent",
      "leave": "#/$defs/LeaveEvent",
      "pad_visibility": "#/$defs/PadVisibilityEvent",
      "player_ready": "#/$defs/PlayerReadyEvent",
      "privacy_changed": "#/$defs/PrivacyChangedEvent",
      "reaction_send": "#/$defs/ReactionSendEvent",
      "request_game_state": "#/$defs/RequestGameStateEvent",
      "restart_game": "#/$defs/RestartGameEvent",
      "settings_update": "#/$defs/SettingsUpdateEvent",
      "start_game": "#/$defs/StartGameEvent",
      "submit_guess": "#/$defs/SubmitGuessEvent",
      "watch": "#/$defs/WatchEvent"
    },
    "propertyName": "type"
  },
  "anyOf": [
    {
      "properties": {
        "type": {
          "const": "join",
          "title": "Type",
          "type": "string"
        },
        "playerId": {
          "maxLength": 64,
          "title": "Playerid",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "title": "Name",
          "type": "string"
        },
        "preferredLocale": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2,5}(?:-[A-Za-z0-9]{2,8})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "preferredColor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferredcolor"
        },
        "rejoinKey": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejoinkey"
        }
      },
      "required": ["name", "playerId", "type"],
      "title": "JoinEvent",
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "start_game",
          "title": "Type",
          "type": "string"
        },
        "difficulty": {
          "anyOf": [
            {
              "enum": ["easy", "medium", "hard"],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rounds": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "drawingTimeLimit": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": 15,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "guessingTimeLimit": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": 15,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": ["type"],
      "title": "StartGameEvent",
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "player_ready",
          "title": "Type",
          "type": "string"
        },
        "playerId": {
          "maxLength": 64,
          "title": "Playerid",
          "type": "string"
        }
      },
      "required": ["playerId", "type"],
      "title": "PlayerReadyEvent",
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "submit_guess",
          "title": "Type",
          "type": "string"
        },
        "targetPlayerId": {
          "title": "Targetplayerid",
          "type": "string"
        },
        "playerId": {
          "maxLength": 64,
          "title": "Playerid",
          "type": "string"
        },
        "guesses": {
          "items": {
            "maxLength": 100,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Guesses",
          "type": "array"
        }
      },
      "required": ["playerId", "targetPlayerId", "type"],
      "title": "SubmitGuessEvent",
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "restart_game",
          "title": "Type",
          "type": "string"
        }
      },
      "required": ["type"],
      "title": "RestartGameEvent",
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "heartbeat",
          "title": "Type",
          "type": "string"
        }
      },
      "required": ["type"],
      "title": "HeartbeatEvent",
      "type": "object"
    },
    {
      "description": "An explicit, intentional leave \u2014 remove the player immediately.",
      "properties": {
        "type": {
          "const": "leave",
          "title": "Type",
          "type": "string"
        }
      },
      "required": ["type"],
      "title": "LeaveEvent",
      "type": "object"
    },
    {
      "description": "Follow the room as a spectator: get its broadcasts without joining.",
      "properties": {
        "type": {
          "const": "watch",
          "title": "Type",
          "type": "string"
        }
      },
      "required": ["type"],
      "title": "WatchEvent",
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "settings_update",
          "title": "Type",
          "type": "string"
        },
        "difficulty": {
          "anyOf": [
            {
              "enum": ["easy", "medium", "hard"],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rounds": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "drawingTimeLimit": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": 15,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "guessingTimeLimit": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": 15,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": ["type"],
      "title": "SettingsUpdateEvent",
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "default_locale_update",
          "title": "Type",
          "type": "string"
        },
        "locale": {
          "pattern": "^[a-z]{2,5}(?:-[A-Za-z0-9]{2,8})?$",
          "type": "string"
        }
      },
      "required": ["type"],
      "title": "DefaultLocaleUpdateEvent",
      "type": "object"
    },
    {
      "additionalProperties": true,
      "properties": {
        "type": {
          "const": "draw_stroke",
          "title": "Type",
          "type": "string"
        },
        "playerId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Playerid"
        }
      },
      "required": ["type"],
      "title": "DrawStrokeEvent",
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "draw_stroke_partial",
          "title": "Type",
          "type": "string"
        },
        "playerId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Playerid"
        },
        "stroke": {
          "anyOf": [
            {
              "description": "A stroke fragment: only the points added since the previous partial.\n\nSending deltas (rather than the whole growing point list every frame) keeps\nan in-progress stroke's relayed payload O(new points) instead of O(n^2).",
              "properties": {
                "color": {
                  "maxLength": 32,
                  "title": "Color",
                  "type": "string"
                },
                "width": {
                  "exclusiveMinimum": 0,
                  "maximum": 64,
                  "title": "Width",
                  "type": "number"
                },
                "points": {
                  "items": {
                    "maximum": 10000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "maxItems": 2000,
                  "title": "Points",
                  "type": "array"
                }
              },
              "required": ["color", "width"],
              "title": "StrokeDelta",
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "strokeStart": {
          "default": false,
          "title": "Strokestart",
          "type": "boolean"
        }
      },
      "required": ["type"],
      "title": "DrawStrokePartialEvent",
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "drawpad_clear",
          "title": "Type",
          "type": "string"
        }
      },
      "required": ["type"],
      "title": "DrawpadClearEvent",
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "pad_visibility",
          "title": "Type",
          "type": "string"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": ["type"],
      "title": "PadVisibilityEvent",
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "privacy_changed",
          "title": "Type",
          "type": "string"
        },
        "isPrivate": {
          "title": "Isprivate",
          "type": "boolean"
        }
      },
      "required": ["isPrivate", "type"],
      "title": "PrivacyChangedEvent",
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "initiate_kick",
          "title": "Type",
          "type": "string"
        },
        "targetPlayerId": {
          "title": "Targetplayerid",
          "type": "string"
        }
      },
      "required": ["targetPlayerId", "type"],
      "title": "InitiateKickEvent",
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "cast_kick_vote",
          "title": "Type",
          "type": "string"
        },
        "targetPlayerId": {
          "title": "Targetplayerid",
          "type": "string"
        }
      },
      "required": ["targetPlayerId", "type"],
      "title": "CastKickVoteEvent",
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "request_game_state",
          "title": "Type",
          "type": "string"
        },
        "playerId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Playerid"
        }
      },
      "required": ["type"],
      "title": "RequestGameStateEvent",
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "const": "reaction_send",
          "title": "Type",
          "type": "string"
        },
        "drawingId": {
          "title": "Drawingid",
          "type": "string"
        },
        "reactionKey": {
          "enum": ["laugh", "shock", "art", "mind-blown", "think"],
          "type": "string"
        }
      },
      "required": ["drawingId", "reactionKey", "type"],
      "title": "ReactionSendEvent",
      "type": "object"
    }
  ]
}
