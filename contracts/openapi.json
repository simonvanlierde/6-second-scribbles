{
  "components": {
    "schemas": {
      "AppInfoResponse": {
        "description": "Root endpoint response.",
        "properties": {
          "cache": {
            "default": "ok",
            "title": "Cache",
            "type": "string"
          },
          "database": {
            "default": "ok",
            "title": "Database",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": ["status", "service", "version"],
        "title": "AppInfoResponse",
        "type": "object"
      },
      "CreateRoomResponse": {
        "description": "Response for newly created room.",
        "properties": {
          "room_code": {
            "title": "Room Code",
            "type": "string"
          }
        },
        "required": ["room_code"],
        "title": "CreateRoomResponse",
        "type": "object"
      },
      "Difficulty": {
        "enum": ["easy", "medium", "hard"],
        "type": "string"
      },
      "GamePhase": {
        "description": "Valid room lifecycle phases for game flow state.",
        "enum": ["lobby", "drawing", "guessing", "round_results", "final_results"],
        "title": "GamePhase",
        "type": "string"
      },
      "GuestAuthRequest": {
        "description": "Optional request body for guest session bootstrap.",
        "properties": {
          "displayName": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Displayname"
          },
          "preferredLocale": {
            "default": "en",
            "maxLength": 16,
            "title": "Preferredlocale",
            "type": "string"
          }
        },
        "title": "GuestAuthRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LanguageCode": {
        "pattern": "^[a-z]{2,5}(?:-[A-Za-z0-9]{2,8})?$",
        "type": "string"
      },
      "LocaleAvailabilityItem": {
        "description": "Aggregated locale support across selectable system categories.",
        "properties": {
          "category_count": {
            "title": "Category Count",
            "type": "integer"
          },
          "difficulty_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Difficulty Counts",
            "type": "object"
          },
          "locale": {
            "$ref": "#/components/schemas/LanguageCode"
          }
        },
        "required": ["locale", "category_count"],
        "title": "LocaleAvailabilityItem",
        "type": "object"
      },
      "QuickPlayResponse": {
        "description": "Response for quick-play: a joinable room, existing or freshly created.",
        "properties": {
          "kind": {
            "enum": ["existing", "created"],
            "title": "Kind",
            "type": "string"
          },
          "room_code": {
            "title": "Room Code",
            "type": "string"
          }
        },
        "required": ["room_code", "kind"],
        "title": "QuickPlayResponse",
        "type": "object"
      },
      "RoomStatusResponse": {
        "description": "Response for room status checks.",
        "properties": {
          "exists": {
            "title": "Exists",
            "type": "boolean"
          },
          "game_phase": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GamePhase"
              },
              {
                "type": "null"
              }
            ]
          },
          "players": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Players"
          }
        },
        "required": ["exists"],
        "title": "RoomStatusResponse",
        "type": "object"
      },
      "StatsResponse": {
        "description": "Server statistics response.",
        "properties": {
          "active_rooms": {
            "title": "Active Rooms",
            "type": "integer"
          },
          "empty_rooms": {
            "title": "Empty Rooms",
            "type": "integer"
          },
          "hibernated_rooms": {
            "title": "Hibernated Rooms",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "total_players": {
            "title": "Total Players",
            "type": "integer"
          },
          "total_rooms": {
            "title": "Total Rooms",
            "type": "integer"
          }
        },
        "required": ["status", "total_rooms", "active_rooms", "hibernated_rooms", "empty_rooms", "total_players"],
        "title": "StatsResponse",
        "type": "object"
      },
      "UserResponse": {
        "description": "Public user payload for the current authenticated session.",
        "properties": {
          "displayName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Displayname"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "isGuest": {
            "title": "Isguest",
            "type": "boolean"
          },
          "preferredLocale": {
            "title": "Preferredlocale",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": ["id", "username", "displayName", "preferredLocale", "isGuest"],
        "title": "UserResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Real-time multiplayer drawing game backend",
    "title": "Six Second Scribbles API",
    "version": "0.2.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/guest": {
      "post": {
        "description": "Create a guest user and authenticated session.",
        "operationId": "create_guest_auth_session_api_auth_guest_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuestAuthRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Guest Auth Session",
        "tags": ["auth"]
      }
    },
    "/api/categories/locales": {
      "get": {
        "description": "Get supported locales with category coverage counts.",
        "operationId": "get_category_locale_availability_api_categories_locales_get",
        "parameters": [
          {
            "in": "query",
            "name": "difficulty",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Difficulty"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Difficulty"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LocaleAvailabilityItem"
                  },
                  "title": "Response Get Category Locale Availability Api Categories Locales Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Category Locale Availability",
        "tags": ["categories"]
      }
    },
    "/api/health": {
      "get": {
        "description": "Health check endpoint including Redis and database connectivity.\n\nAnswers 503 with the same body when either is down, so container health checks and\n`docker compose up --wait` see a degraded backend as failing.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppInfoResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": ["system"]
      }
    },
    "/api/me": {
      "get": {
        "description": "Return the current authenticated user.",
        "operationId": "get_me_api_me_get",
        "parameters": [
          {
            "in": "cookie",
            "name": "scribbles_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Scribbles Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Me",
        "tags": ["users"]
      }
    },
    "/api/rooms/": {
      "post": {
        "description": "Create a new room with a unique alphanumeric code and reserve it in Redis.\n\nThis endpoint attempts several times to generate a code and atomically set the\nRedis key, so a new code never reuses one still held in Redis. On success it\ncreates the in-memory room and persists initial state. Rooms live in this\nprocess's memory, so the backend must run as a single worker: another worker\nwould not see the room created here.",
        "operationId": "create_room_api_rooms__post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRoomResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Create Room",
        "tags": ["rooms"]
      }
    },
    "/api/rooms/quick-play": {
      "post": {
        "description": "Return a joinable public room, creating one if none are available.\n\nIntended for the Home screen's one-tap \"Quick-play\" action: pick a random\npublic room in the lobby phase with room left, or create a fresh one.",
        "operationId": "quick_play_api_rooms_quick_play_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuickPlayResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Quick Play",
        "tags": ["rooms"]
      }
    },
    "/api/rooms/{room_id}/status": {
      "get": {
        "description": "Get the status of a room.",
        "operationId": "room_status_api_rooms__room_id__status_get",
        "parameters": [
          {
            "in": "path",
            "name": "room_id",
            "required": true,
            "schema": {
              "pattern": "^[ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789]{6}$",
              "title": "Room Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Room Status",
        "tags": ["rooms"]
      }
    },
    "/api/stats": {
      "get": {
        "description": "Get server statistics including room and player counts.",
        "operationId": "get_stats_api_stats_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Stats",
        "tags": ["system"]
      }
    }
  }
}
